{
    "name": "fast-auth-indexer-api",
    "version": "1.0.0",
    "description": "FastAuth Indexer + Read API",
    "private": true,
    "author": "Peersyst",
    "license": "ISC",
    "packageManager": "pnpm@8.15.4",
    "engines": {
        "node": ">=18"
    },
    "scripts": {
        "prebuild": "rimraf dist",
        "build": "nest build",
        "dev": "nest start --watch",
        "start": "nest start",
        "start:debug": "nest start --debug --watch",
        "start:prod": "node ./dist/src/main",
        "cli": "env-cmd --silent ts-node ./src/cli.ts",
        "cli:prod": "node ./dist/src/cli.js",
        "worker": "env-cmd --silent ts-node ./src/worker.ts",
        "worker:prod": "node --max-old-space-size=2048 ./dist/src/worker.js",
        "lint": "eslint . --ext .ts,.json",
        "lint:fix": "prettier --config .prettierrc '**/*.{json,ts}' --write && eslint . --ext .ts,.json --fix",
        "test": "jest",
        "test:coverage": "jest --coverage",
        "test:unit": "jest --watch",
        "typeorm": "env-cmd --silent typeorm-ts-node-commonjs",
        "db:migration:create": "npm run typeorm migration:create --",
        "db:migration:generate": "npm run typeorm migration:generate -- -d ./src/config/typeormConfig.ts",
        "db:migration:run": "npm run typeorm migration:run -- -d ./src/config/typeormConfig.ts",
        "db:migration:revert": "npm run typeorm migration:revert -- -d ./src/config/typeormConfig.ts",
        "db:entities:generate": "env-cmd --silent typeorm-model-generator -e postgres -o ./src/database --noConfig --case-property camel --case-file pascal"
    },
    "jest": {
        "moduleFileExtensions": [
            "js",
            "json",
            "ts"
        ],
        "rootDir": ".",
        "testRegex": ".*\\.spec\\.ts$",
        "modulePathIgnorePatterns": [
            "<rootDir>/dist/"
        ],
        "transform": {
            "^.+\\.ts$": "ts-jest"
        },
        "collectCoverageFrom": [
            "./src/modules/**/*.ts",
            "!./src/modules/common/**/*.ts",
            "!./src/modules/**/*.controller.ts",
            "!./src/modules/**/*.request.ts",
            "!./src/modules/**/*.dto.ts",
            "!./src/modules/**/*.module.ts",
            "!./src/modules/**/*.command.ts",
            "!./src/modules/**/*.commands.ts"
        ],
        "coverageDirectory": "./coverage",
        "testEnvironment": "node",
        "coverageThreshold": {
            "global": {
                "branches": 75,
                "statements": 85
            }
        }
    },
    "dependencies": {
        "@nanogiants/nestjs-swagger-api-exception-decorator": "^1.6.5",
        "@nestjs/common": "^9.4.3",
        "@nestjs/config": "^2.2.0",
        "@nestjs/core": "^9.4.3",
        "@nestjs/platform-express": "^9.4.3",
        "@nestjs/schedule": "^2.2.3",
        "@nestjs/swagger": "^6.1.2",
        "@nestjs/typeorm": "^9.0.1",
        "bs58": "^5.0.0",
        "class-transformer": "^0.5.1",
        "class-validator": "^0.13.2",
        "cross-env": "^7.0.3",
        "env-cmd": "^10.1.0",
        "express-openapi-validator": "^4.13.8",
        "helmet": "^6.0.0",
        "morgan": "^1.10.0",
        "nest-winston": "^1.7.1",
        "nestjs-command": "^3.1.2",
        "object-mapper": "^6.2.0",
        "pg": "^8.11.3",
        "reflect-metadata": "^0.1.13",
        "rimraf": "^3.0.2",
        "rxjs": "^7.5.7",
        "swagger-ui-express": "^4.5.0",
        "typeorm": "^0.3.10",
        "winston": "^3.8.2",
        "yargs": "^17.6.0"
    },
    "devDependencies": {
        "@nestjs/cli": "^10.0.5",
        "@nestjs/testing": "^9.4.3",
        "@types/express": "^4.17.14",
        "@types/jest": "^29.2.0",
        "@types/morgan": "^1.9.3",
        "@types/node": "^18.8.5",
        "@types/object-mapper": "^6.2.0",
        "@types/supertest": "^2.0.12",
        "@types/yargs": "^17.0.13",
        "@typescript-eslint/eslint-plugin": "^5.40.0",
        "@typescript-eslint/parser": "^5.40.0",
        "eslint": "^8.25.0",
        "eslint-config-prettier": "^8.5.0",
        "eslint-plugin-import": "^2.26.0",
        "eslint-plugin-prettier": "^4.2.1",
        "jest": "^29.2.0",
        "nock": "^13.2.9",
        "prettier": "^2.7.1",
        "supertest": "^6.3.0",
        "ts-jest": "^29.0.3",
        "ts-loader": "^9.4.1",
        "ts-node": "^10.9.1",
        "tsconfig-paths": "^4.1.0",
        "typeorm-model-generator": "^0.4.6",
        "typescript": "^4.8.4"
    }
}
