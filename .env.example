# =============================================================================
# fast-auth-indexer-api — env template
#
# This repo deploys as TWO Railway services from the same source tree:
#
#   1. fast-auth-indexer-api     (HTTP read API — `pnpm run start:prod`)
#   2. fast-auth-indexer-worker  (long-running indexer — `pnpm run worker:prod`)
#
# Both services point at the SAME Postgres (DATABASE_URL).
# Locally you only need one .env — the API and worker scripts both consume
# this file via env-cmd.
# =============================================================================


# =============================================================================
# PRODUCTION-ESSENTIAL VARS (Railway)
#
# Every other var in this file is either auto-injected by Railway (PORT,
# NODE_ENV) or has a sensible hardcoded default in src/config/configuration.ts.
# Set the ones below per service; leave the rest unset.
#
# --- API SERVICE (fast-auth-indexer-api) ---
#   DATABASE_URL          ${{Postgres.DATABASE_URL}}   # reference, not literal
#   DB_MIGRATIONS_RUN     1                             # API owns migrations
#   INDEXER_CRON_SECRET   <openssl rand -hex 32>        # leave empty to disable trigger
#
#   Recommended (not strictly required):
#   APP_ENABLE_CORS       1                             # cross-origin frontend
#   APP_ENABLE_SWAGGER    0 in prod, 1 in staging
#
# --- WORKER SERVICE (fast-auth-indexer-worker) ---
#   DATABASE_URL          ${{Postgres.DATABASE_URL}}   # SAME reference as API
#   DB_MIGRATIONS_RUN     0                             # only the API runs migrations
#
# Auto-injected by Railway (do NOT set):
#   PORT                  → consumed by main.ts
#   NODE_ENV=production   → triggers SSL auto-on in typeormConfig.ts
# =============================================================================


# =============================================================================
# SERVICE 1 — fast-auth-indexer-api  (HTTP read API)
# =============================================================================

# --- HTTP server ---
APP_PORT=3000
APP_ENABLE_SWAGGER=1
APP_ENABLE_CORS=1

# --- Database (Postgres on Railway) ---
# Prefer DATABASE_URL (Railway injects this automatically when you reference
# the Postgres plugin). The DB_* fallbacks below are used only when
# DATABASE_URL is not set (e.g. local dev against a docker-compose Postgres).
# DATABASE_URL=postgresql://postgres:password@host:5432/railway
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=postgres
DB_DATABASE=fast_auth_metrics
# Never let TypeORM ALTER the schema — Prisma owns the DDL.
DB_SYNCHRONIZE=0
# API runs migrations on first boot (idempotent CREATE…IF NOT EXISTS).
DB_MIGRATIONS_RUN=1
# Force SSL even outside production (Railway, Supabase, RDS require it).
# Auto-on when NODE_ENV=production; explicit override here for staging.
# DB_SSL=1

# --- Indexer trigger endpoint (HMAC-gated POST /api/indexers/run) ---
# Generate a strong secret: `openssl rand -hex 32`
INDEXER_CRON_SECRET=
# Optional comma-separated source IP allowlist for the trigger endpoint.
INDEXER_ALLOWED_IPS=

# --- NEAR ingest tuning ---
# Override via env only when truly needed; defaults are deployment-invariant.
NEAR_NETWORK=mainnet
NEAR_FASTAUTH_CONTRACT_IDS=fast-auth.near,jwt.fast-auth.near,auth0.jwt.fast-auth.near
NEAR_MPC_CONTRACT_IDS=v1.signer

# --- Public-key resolver (FastNEAR) ---
FASTNEAR_API_BASE=https://api.fastnear.com

# --- Synthetic traffic flagging in MPC consensus ---
SYNTHETIC_SIGNER_IDS=tx-bench.near

# --- Logging ---
LOG_LEVEL=info
LOG_FILE=logs/app.log


# =============================================================================
# SERVICE 2 — fast-auth-indexer-worker  (long-running indexer)
#
# In Railway, create a SECOND service from the same GitHub repo:
#   Settings → Deploy → Custom Start Command:  pnpm run worker:prod
#   Settings → Deploy → Healthcheck Path:      (leave empty — no HTTP surface)
#
# Variables: copy every var above with the two overrides shown below.
# Skip APP_PORT / APP_ENABLE_SWAGGER / APP_ENABLE_CORS (worker has no HTTP).
# =============================================================================

# --- Database (same Postgres as the API, but no migrations from the worker) ---
# DATABASE_URL=${{Postgres-fastauth-v2.DATABASE_URL}}   # same reference as the API service
# DB_SYNCHRONIZE=0
# Worker must NOT run migrations — only one service owns them, and that's the API.
# DB_MIGRATIONS_RUN=0

# --- All other vars (INDEXER_CRON_SECRET, NEAR_*, FASTNEAR_API_BASE,
# SYNTHETIC_SIGNER_IDS, LOG_LEVEL, LOG_FILE) are identical to SERVICE 1 above.
# INDEXER_CRON_SECRET is technically only consumed by the API's HMAC guard,
# but harmless to set on the worker too.
